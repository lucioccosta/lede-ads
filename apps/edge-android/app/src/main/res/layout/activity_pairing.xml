<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto-registro: o box se apresenta sozinho ao Cloud e espera a LEDE aceitar.
  Só o logo e o código da tela (calculado localmente — aparece mesmo sem rede).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="48dp">

    <ImageView
        android:id="@+id/registrationLogo"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/lede_logo" />

    <TextView
        android:id="@+id/registrationCode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:includeFontPadding="false"
        android:letterSpacing="0.15"
        android:textColor="#FFFFFF"
        android:textSize="56sp"
        android:textStyle="bold" />
</LinearLayout>
