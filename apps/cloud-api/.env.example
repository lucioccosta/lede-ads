DATABASE_URL="postgresql://lede:lede@localhost:5432/lede_ads?schema=public"
JWT_SECRET="lede-dev-secret-change-me"
JWT_EXPIRES_IN="7d"
PORT=3001
# URL pública da API (login/CORS/health). Edge usa a URL da mídia no S3.
PUBLIC_BASE_URL="http://localhost:3001"
CORS_ORIGIN="http://localhost:3000"

# Storage: s3 | local
STORAGE_DRIVER="s3"
S3_ENDPOINT="https://object.sp2.eveo.com.br"
S3_REGION="us-east-1"
S3_BUCKET="lede-arquivos"
S3_TENANT="48806696000174"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
# URL pública dos objetos (Eveo). Sem barra no final.
S3_PUBLIC_URL="https://object.sp2.eveo.com.br/48806696000174:lede-arquivos"
# true para MinIO / S3-compatible (Eveo)
S3_FORCE_PATH_STYLE="true"
# Opcional: public-read se o provedor exigir ACL no put
# S3_ACL="public-read"

REDIS_URL="redis://localhost:6379"
