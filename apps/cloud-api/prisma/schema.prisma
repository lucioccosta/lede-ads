generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  lede_admin
  lede_operator
  client_viewer
  client_approver
}

enum MediaStatus {
  draft
  pending_approval
  approved
  rejected
  archived
}

enum MediaType {
  image
  video
}

enum DeviceStatus {
  online
  offline
  pairing
  unknown
}

enum DeviceOrientation {
  landscape
  portrait
  landscape_reverse
  portrait_reverse
}

enum DeviceCommandType {
  resync
  reboot
  screenshot
  update
}

enum DeviceCommandStatus {
  pending
  running
  done
  failed
}

enum ScreenTypeMode {
  standard
  condo_split
}

enum ScheduleChannel {
  takeover
  condo_notice
  paid_ad
}

enum ClientKind {
  condo
  advertiser
  network
}

model Client {
  id        String     @id @default(cuid())
  name      String
  document  String?
  email     String?
  phone     String?
  kind      ClientKind @default(advertiser)
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  users              User[]
  plans              Plan[]
  media              Media[]
  scenes             Scene[]
  schedules          Schedule[]
  devices            Device[]
  deviceGroups       DeviceGroup[]
  allowedScreenTypes ClientScreenType[]
  changeLogs         ChangeLog[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole
  clientId     String?
  client       Client?  @relation(fields: [clientId], references: [id])
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  changeLogs ChangeLog[]
}

/** Permissões configuradas por perfil. Sem linha = padrões do código. */
model RolePermission {
  role        UserRole @id
  permissions String[]
  updatedAt   DateTime @updatedAt
}

model Plan {
  id            String    @id @default(cuid())
  clientId      String?
  client        Client?   @relation(fields: [clientId], references: [id])
  name          String
  samplesPerDay Int
  months        Int       @default(1)
  startsAt      DateTime
  endsAt        DateTime?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  schedules   Schedule[]
  deviceGroups PlanDeviceGroup[]
  proofs      ProofOfPlay[]
}

model DeviceGroup {
  id                  String   @id @default(cuid())
  name                String
  clientId            String
  client              Client   @relation(fields: [clientId], references: [id])
  active              Boolean  @default(true)
  viewingHoursPerDay  Int      @default(18)
  sampleDurationSec   Int      @default(10)
  /** Público estimado (métrica comercial). */
  impactedPeople      Int      @default(0)
  /** Preço por tela/mês em centavos (ex.: 3750 = R$ 37,50). */
  pricePerScreenCents Int      @default(0)
  houseSceneId        String?
  houseScene          Scene?   @relation("GroupHouseScene", fields: [houseSceneId], references: [id])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  devices    Device[]
  plans      PlanDeviceGroup[]
  schedules  Schedule[]
}

model PlanDeviceGroup {
  id            String      @id @default(cuid())
  planId        String
  plan          Plan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  deviceGroupId String
  deviceGroup   DeviceGroup @relation(fields: [deviceGroupId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([planId, deviceGroupId])
}

model ScreenType {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  description String?
  mode        ScreenTypeMode @default(standard)
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  layouts Layout[]
  devices Device[]
  clients ClientScreenType[]
}

model ClientScreenType {
  id           String     @id @default(cuid())
  clientId     String
  client       Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  screenTypeId String
  screenType   ScreenType @relation(fields: [screenTypeId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([clientId, screenTypeId])
}

model Layout {
  id            String     @id @default(cuid())
  name          String
  screenTypeId  String
  screenTypeRef ScreenType @relation(fields: [screenTypeId], references: [id])
  width         Int
  height        Int
  zonesJson     Json
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  scenes Scene[]
}

model Media {
  id            String      @id @default(cuid())
  clientId      String
  client        Client      @relation(fields: [clientId], references: [id])
  name          String
  type          MediaType
  status        MediaStatus @default(draft)
  mimeType      String
  url           String
  checksum      String
  durationMs    Int         @default(10000)
  fileSize      Int         @default(0)
  rejectionNote String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  sceneZones     SceneZone[]
  sceneZoneItems SceneZoneItem[]
  proofs         ProofOfPlay[]
}

model Scene {
  id         String   @id @default(cuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id])
  layoutId   String
  layout     Layout   @relation(fields: [layoutId], references: [id])
  name       String
  durationMs Int      @default(10000)
  active     Boolean  @default(true)
  isHouseAd  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  zones       SceneZone[]
  schedules   Schedule[]
  proofs      ProofOfPlay[]
  houseGroups DeviceGroup[] @relation("GroupHouseScene")
}

model SceneZone {
  id      String @id @default(cuid())
  sceneId String
  scene   Scene  @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  zoneKey String
  /** Primeiro item da playlist (compat dashboard / sync legado). */
  mediaId String?
  media   Media? @relation(fields: [mediaId], references: [id])

  items SceneZoneItem[]

  @@unique([sceneId, zoneKey])
}

/** Playlist ordenada da zona (Stories do condomínio). */
model SceneZoneItem {
  id          String    @id @default(cuid())
  sceneZoneId String
  sceneZone   SceneZone @relation(fields: [sceneZoneId], references: [id], onDelete: Cascade)
  mediaId     String
  media       Media     @relation(fields: [mediaId], references: [id])
  sortOrder   Int       @default(0)
  durationMs  Int       @default(10000)
  createdAt   DateTime  @default(now())

  @@index([sceneZoneId, sortOrder])
}

model Device {
  id                String            @id @default(cuid())
  name              String
  /** Código curto visível na tela física e no Cloud (ex.: A3F2). */
  shortCode         String            @unique
  pairingCode       String?           @unique
  deviceToken       String?           @unique
  status            DeviceStatus      @default(unknown)
  orientation       DeviceOrientation @default(landscape)
  timezone          String            @default("America/Manaus")
  clientId          String?
  client            Client?           @relation(fields: [clientId], references: [id])
  groupId           String?
  group             DeviceGroup?      @relation(fields: [groupId], references: [id])
  screenTypeId      String?
  screenType        ScreenType?       @relation(fields: [screenTypeId], references: [id])
  lastHeartbeatAt   DateTime?
  lastScreenshotUrl String?
  appVersion        String?
  appVersionCode    Int?
  appFlavor         String?
  freeStorageBytes  BigInt?
  totalStorageBytes BigInt?
  ramAvailBytes     BigInt?
  ramTotalBytes     BigInt?
  cpuUsagePercent   Float?
  uptimeMs          BigInt?
  ipAddress         String?
  /** IP público visto pela API no heartbeat (NAT / WAN). */
  externalIp        String?
  screenWidth       Int?
  screenHeight      Int?
  locationLabel     String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  schedules    Schedule[]
  proofs       ProofOfPlay[]
  commands     DeviceCommand[]
  registration DeviceRegistration?
}

enum DeviceRegistrationStatus {
  pending
  approved
  rejected
}

/**
 * Auto-registro do Edge: o box se apresenta sozinho (hardwareId + segredo)
 * e a LEDE aceita ou recusa no Cloud. Aceito → cria/vincula um Device e o
 * Edge recebe o deviceToken na próxima consulta de status.
 */
model DeviceRegistration {
  id           String                   @id @default(cuid())
  /** Identidade estável do hardware (ex.: SID do SoC Allwinner). */
  hardwareId   String                   @unique
  /** sha256 do segredo gerado pelo Edge; exigido para consultar o status. */
  secretHash   String
  /** Código curto exibido na tela do box para conferência visual. */
  code         String
  status       DeviceRegistrationStatus @default(pending)
  hostname     String?
  model        String?
  macAddress   String?
  ipAddress    String?
  externalIp   String?
  appVersion   String?
  appFlavor    String?
  screenWidth  Int?
  screenHeight Int?
  rejectReason String?
  deviceId     String?                  @unique
  device       Device?                  @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  decidedAt    DateTime?
  decidedById  String?
  lastSeenAt   DateTime                 @default(now())
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@index([status, lastSeenAt])
}

model DeviceCommand {
  id          String              @id @default(cuid())
  deviceId    String
  device      Device              @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  type        DeviceCommandType
  status      DeviceCommandStatus @default(pending)
  payloadJson Json?
  error       String?
  createdAt   DateTime            @default(now())
  ackedAt     DateTime?

  @@index([deviceId, status, createdAt])
}

model Schedule {
  id            String          @id @default(cuid())
  name          String
  clientId      String
  client        Client          @relation(fields: [clientId], references: [id])
  sceneId       String
  scene         Scene           @relation(fields: [sceneId], references: [id])
  planId        String?
  plan          Plan?           @relation(fields: [planId], references: [id])
  deviceId      String?
  device        Device?         @relation(fields: [deviceId], references: [id])
  groupId       String?
  group         DeviceGroup?    @relation(fields: [groupId], references: [id])
  channel       ScheduleChannel @default(takeover)
  priority      Int             @default(0)
  daysOfWeek    Int[]
  startTime     String
  endTime       String
  startsAt      DateTime?
  endsAt        DateTime?
  active        Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  proofs ProofOfPlay[]
}

model ProofOfPlay {
  id         String    @id @default(cuid())
  deviceId   String
  device     Device    @relation(fields: [deviceId], references: [id])
  sceneId    String
  scene      Scene     @relation(fields: [sceneId], references: [id])
  mediaId    String
  media      Media     @relation(fields: [mediaId], references: [id])
  planId     String?
  plan       Plan?     @relation(fields: [planId], references: [id], onDelete: SetNull)
  scheduleId String?
  schedule   Schedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  startedAt  DateTime
  endedAt    DateTime
  checksum   String
  createdAt  DateTime  @default(now())

  @@index([deviceId, startedAt])
  @@index([mediaId, startedAt])
  @@index([planId, startedAt])
  @@index([scheduleId, startedAt])
}

enum ChangeLogAction {
  condo_media_changed
  media_uploaded
  media_reviewed
}

model ChangeLog {
  id          String          @id @default(cuid())
  clientId    String
  client      Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      ChangeLogAction
  summary     String
  detailsJson Json?
  createdAt   DateTime        @default(now())

  @@index([clientId, createdAt])
}

/** Configurações globais do Cloud (ex.: ticker.enabledKeys). */
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
