# Cole na aba Environment do Dokploy (Compose).
# NÃO commite senhas reais no Git.

# --- Postgres ---
POSTGRES_USER=lede
POSTGRES_PASSWORD=troque-esta-senha-forte
POSTGRES_DB=lede_ads

# --- API ---
JWT_SECRET=troque-por-um-segredo-longo-aleatorio
JWT_EXPIRES_IN=7d
PUBLIC_BASE_URL=https://api.lede.tv.br
CORS_ORIGIN=https://app.lede.tv.br

RUN_SEED=true
SEED_ADMIN_EMAIL=admin@lede.com
SEED_ADMIN_PASSWORD=troque-a-senha-do-admin
SEED_ADMIN_NAME=Admin LEDE

# --- S3 (Eveo / S3-compatible) ---
STORAGE_DRIVER=s3
S3_ENDPOINT=https://object.sp2.eveo.com.br
S3_REGION=us-east-1
S3_BUCKET=lede-arquivos
S3_TENANT=48806696000174
S3_ACCESS_KEY=coloque-a-access-key
S3_SECRET_KEY=coloque-a-secret-key
S3_PUBLIC_URL=https://object.sp2.eveo.com.br/48806696000174:lede-arquivos
S3_FORCE_PATH_STYLE=true
# S3_ACL=public-read

# --- Edge OTA (GitHub Releases, flavor prod / target sb3000) ---
GITHUB_REPO=lucioccosta/lede-ads
# Opcional — rate limit / releases privadas
# GITHUB_TOKEN=

# --- Web ---
NEXT_PUBLIC_API_URL=https://api.lede.tv.br
