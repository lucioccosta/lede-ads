{
  "name": "lede-ads",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:web": "npm run dev -w apps/cloud-web",
    "dev:api": "npm run start:dev -w apps/cloud-api",
    "build": "npm run build --workspaces --if-present",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  }
}
